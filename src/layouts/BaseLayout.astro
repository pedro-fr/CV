---
import profile from '../../content/profile.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import type { PageKey } from '../data/navigation';
import { url } from '../utils/urls';
import '../styles/global.css';
interface Props { title: string; description?: string; currentPage?: PageKey; noindex?: boolean }
const { title, description = profile.description, currentPage, noindex = false } = Astro.props;
const canonical = new URL(noindex ? url('404.html') : Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · {profile.name}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${profile.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('images/CV_photo.png'), Astro.site).href} />
    <link rel="icon" href={url('assets/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.dataset.theme = 'light';
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body data-base={url()}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header currentPage={currentPage} />
      <main id="main" tabindex="-1" class={currentPage === 'home' ? 'home' : 'interior'}><slot /></main>
      <Footer />
    </div>
    <SearchDialog />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
