<dialog id="search-dialog" aria-labelledby="search-title">
  <div class="search-heading"><h2 id="search-title">Search the website</h2><button class="icon-button" id="search-close" aria-label="Close search">×</button></div>
  <label class="sr-only" for="search-input">Search term</label>
  <input id="search-input" type="search" placeholder="Research, publications, skills…" autocomplete="off" />
  <div id="search-results" aria-live="polite"></div>
  <p class="search-hint">Type to search · Esc to close</p>
</dialog>
