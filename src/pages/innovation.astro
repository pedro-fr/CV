---
import profile from '../../content/profile.json';
import copy from '../../content/pages/innovation.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
const project = profile.innovation;
---
<BaseLayout title={copy.title} description={copy.description} currentPage="innovation">
  <PageHeading {...copy} />
  <article class="innovation-case">
    <div class="case-heading">
      <p class="eyebrow">{project.organization}</p>
      <h2>{project.title}</h2>
      <p class="lead">{project.involvement}</p>
    </div>
    <Section title={copy.sections.project}><p>{project.context}</p></Section>
    {project.contribution && <Section title={copy.sections.contribution}><p>{project.contribution}</p></Section>}
    {project.work.length > 0 && <Section title={copy.sections.work}>
      <ul class="detail-list">{project.work.map(item => <li>{item}</li>)}</ul>
    </Section>}
    {project.outcomes.length > 0 && <Section title={copy.sections.outcomes}>
      <ul class="detail-list">{project.outcomes.map(item => <li>{item}</li>)}</ul>
    </Section>}
    <Section title={copy.sections.resources}>
      {project.resources.map(resource => <p><a class="text-link" href={resource.url}>{resource.label} <Icon name="external" /></a></p>)}
    </Section>
  </article>
</BaseLayout>
